{
  "manifest_version": 3,
  "name": "War Room: Confidential AI War-Gaming",
  "version": "0.1.0",
  "description": "The cloud does the thinking, the device keeps the secrets.",
  "key": "",
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open War Room",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
